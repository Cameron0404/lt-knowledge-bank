#!/bin/bash
# kb - load the knowledge bank's settings, then run one of its commands.
#
#   bin/kb ask "how does the backup work"      knowledge.py ask (and every other knowledge.py command)
#   bin/kb hook --entry E --brief B --run R    the launch hook, kb_hook.py
#   bin/kb daily                               the daily upkeep, daily.sh
#   bin/kb termcheck --terms                   the term blocklist
#
# Settings come from KB_ENV_FILE, else ~/.config/knowledge-bank/env (made by setup.sh from
# .env.example). Variables already set in the environment win.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${KB_ENV_FILE:-$HOME/.config/knowledge-bank/env}"
if [ -f "$ENV_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"
    val="${val%\"}"; val="${val#\"}"
    val="${val/#\~/$HOME}"
    if [ -z "${!key:-}" ] && [ -n "$val" ]; then export "$key=$val"; fi
  done < "$ENV_FILE"
fi
PY="${KB_PYTHON:-python3}"
# scan writes the live index only from the source repo, so run it (and daily) from there.
if [ "${1:-}" = "scan" ] || [ "${1:-}" = "daily" ]; then
  if [ -n "${KB_SOURCE_REPO:-}" ]; then cd "$KB_SOURCE_REPO"; fi
fi
case "${1:-}" in
  hook) shift; exec "$PY" "$HERE/kb/kb_hook.py" "$@" ;;
  daily) shift; exec bash "$HERE/kb/daily.sh" "$@" ;;
  termcheck) shift; exec "$PY" "$HERE/kb/termcheck.py" "$@" ;;
  *) exec "$PY" "$HERE/kb/knowledge.py" "$@" ;;
esac
