# Knowledge bank settings. setup.sh copies this to ~/.config/knowledge-bank/env, and bin/kb
# loads that file. Every value here is a placeholder: edit the copy, not this file.
# Paths may start with ~. A blank value means "use the default".

# The git repo whose files your pages cite (docs/, CLAUDE.md, reports). Default: the folder
# you run the command in.
KB_SOURCE_REPO=~/path/to/your/repo
# The branch tracked claims are checked against.
KB_MAIN_BRANCH=main

# Your notes vault, and the bank folder inside it (a real folder, never a symlink).
KB_VAULT=~/vault
KB_LIVE_ROOT=~/vault/wiki/knowledge
# Where pages are written and verified before install.
KB_STAGING=~/kb-staging
# Index, logs, cache and the kill switch. Keep it out of the vault and the repo.
KB_STATE_HOME=~/.local/state/knowledge-bank

# Terms that must never reach a shared page or a brief (employers, clients, reference
# numbers), one per line. Keep this file outside any repo.
KB_BLOCKLIST=~/.config/knowledge-bank/blocklist.txt
# Other people's names, one per line, so no page is ever about a person. Outside any repo.
KB_PEOPLE_FILE=~/.config/knowledge-bank/people.txt
# Your own name parts, space separated, which are never treated as another person.
KB_OWNER_NAMES=ada example

# Repo-relative trees whose contents leave the machine, colon separated. A /build
# deliverable under one gets no block.
KB_EXPORT_TREES=vault/prep:vault/exams
# Repo-relative trees of group work shared with other people, colon separated. A deliverable
# under one is outward too.
KB_COURSEWORK_TREES=_meta/coursework-queue:vault/revision

# The queue the nightly distil brief goes to. Blank: the bundled kb/queue_add.py, which
# writes entries to scheduled-work/ at the repo root for your runner to pick up.
KB_QUEUE_ADD=
# Path prefixes that are never a source (call recordings, video frames), colon separated.
KB_EXCLUDE=~/Documents/Recordings:_meta/video
# Folders of meeting JSON files whose attendees, absent and task owner names join the people
# list, colon separated. Blank: none.
KB_ATTENDEE_DIRS=

# A command run by daily.sh before the scan, for example your vault indexer. Blank: none.
KB_PRE_SCAN_CMD=
